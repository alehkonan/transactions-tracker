{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["routeTree.gen.ts"],
  "sortImports": {
    "newlinesBetween": false,
    "groups": [
      "value-builtin",
      "value-external",
      "value-internal",
      "value-parent",
      "value-sibling",
      "value-index",
      "unknown"
    ]
  },
  "sortPackageJson": true,
  "sortTailwindcss": true
}
