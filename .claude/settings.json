{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "theme": "dark",
  "model": "claude-opus-5",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git add:*)",
      "Bash(pnpm generate-routes *)",
      "Bash(pnpm view *)",
      "Bash(pnpm format *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm knip *)",
      "Bash(pnpm test*)",
      "Bash(playwright-cli *)",
      "Bash(node *)"
    ],
    "ask": ["Bash(gh pr create:*)", "Bash(git commit:*)"],
    "deny": ["Read(*.env*)", "Bash(rm:*)", "Bash(curl:*)", "Bash(git push:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(perl *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-perl.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
